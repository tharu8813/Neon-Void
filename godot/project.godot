; Neon Void Godot 4 additive port foundation. Source-of-truth: docs/GODOT_MIGRATION_BASELINE.md
config_version=5

[application]
config/name="Neon Void 3D"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
RuntimeConfig="*res://scripts/runtime_config.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.02, 0.025, 0.055, 1)
