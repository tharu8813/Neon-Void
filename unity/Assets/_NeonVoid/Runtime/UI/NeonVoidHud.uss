.hud {
    flex-grow: 1;
    justify-content: space-between;
    padding-top: 18px;
    padding-right: 24px;
    padding-bottom: 18px;
    padding-left: 24px;
}

.hud__top {
    flex-direction: row;
    justify-content: center;
}

.hud__bottom {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.hidden {
    display: none;
}

/* --- 백신 성장 터미널 ---------------------------------------------------------- */

.growth {
    position: absolute;
    top: 56px;
    right: 24px;
    bottom: 132px;
    width: 440px;
    padding-top: 14px;
    padding-right: 16px;
    padding-bottom: 14px;
    padding-left: 16px;
    background-color: rgba(10, 16, 28, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(120, 230, 255, 0.45);
    border-right-color: rgba(120, 230, 255, 0.45);
    border-top-color: rgba(120, 230, 255, 0.45);
    border-bottom-color: rgba(120, 230, 255, 0.45);
}

.growth__title {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(120, 230, 255);
}

.growth__points {
    font-size: 13px;
    color: rgb(226, 236, 250);
    margin-top: 4px;
    margin-bottom: 8px;
}

.growth__unavailable {
    font-size: 12px;
    color: rgb(255, 196, 92);
    white-space: normal;
    margin-bottom: 8px;
}

.growth__redistribute {
    height: 26px;
    margin-bottom: 8px;
    margin-left: 0;
    margin-right: 0;
    font-size: 12px;
    color: rgb(226, 236, 250);
    background-color: rgba(28, 44, 68, 0.95);
    border-left-color: rgba(120, 230, 255, 0.5);
    border-right-color: rgba(120, 230, 255, 0.5);
    border-top-color: rgba(120, 230, 255, 0.5);
    border-bottom-color: rgba(120, 230, 255, 0.5);
}

.growth__redistribute:hover {
    background-color: rgba(44, 70, 104, 0.95);
}

.growth__rows {
    flex-grow: 1;
}

.growth__refusal {
    font-size: 12px;
    color: rgb(255, 150, 140);
    white-space: normal;
    margin-top: 6px;
}

.growth__note {
    font-size: 11px;
    color: rgba(150, 168, 190, 0.85);
    white-space: normal;
    margin-top: 6px;
}

.growth-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 3px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(120, 230, 255, 0.10);
}

.growth-row__left {
    flex-grow: 1;
    flex-shrink: 1;
}

.growth-row__name {
    font-size: 12px;
    color: rgb(214, 226, 242);
}

.growth-row__values {
    flex-direction: row;
    align-items: center;
}

.growth-row__current {
    font-size: 12px;
    color: rgb(120, 230, 255);
}

/* 미리보기는 현재 값과 같은 색으로 그리지 않는다 - docs/05 section 2: 저장 전 값 확정 표시 금지. */
.growth-row__arrow {
    font-size: 11px;
    color: rgba(150, 168, 190, 0.8);
    margin-left: 4px;
    margin-right: 4px;
}

.growth-row__preview {
    font-size: 12px;
    color: rgb(214, 186, 132);
    -unity-font-style: italic;
}

.growth-row__reduction {
    font-size: 11px;
    color: rgba(150, 168, 190, 0.9);
    margin-left: 8px;
}

.growth-row__buy {
    width: 86px;
    height: 22px;
    font-size: 11px;
    color: rgb(226, 236, 250);
    background-color: rgba(28, 44, 68, 0.95);
    border-left-color: rgba(120, 230, 255, 0.5);
    border-right-color: rgba(120, 230, 255, 0.5);
    border-top-color: rgba(120, 230, 255, 0.5);
    border-bottom-color: rgba(120, 230, 255, 0.5);
}

.growth-row__buy:hover {
    background-color: rgba(44, 70, 104, 0.95);
}

.growth-row__reason {
    font-size: 10px;
    color: rgba(214, 186, 132, 0.85);
    white-space: normal;
}

.growth-row__why {
    width: 72px;
    flex-shrink: 0;
    font-size: 10px;
    color: rgba(214, 186, 132, 0.9);
    -unity-text-align: middle-right;
}

/* --- 보상 플러그인 ------------------------------------------------------------- */

.reward {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 7, 14, 0.9);
}

.reward__card {
    width: 760px;
    max-width: 95%;
    padding-top: 20px;
    padding-right: 22px;
    padding-bottom: 16px;
    padding-left: 22px;
    background-color: rgba(10, 16, 28, 0.97);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(120, 230, 255, 0.5);
    border-right-color: rgba(120, 230, 255, 0.5);
    border-top-color: rgba(120, 230, 255, 0.5);
    border-bottom-color: rgba(120, 230, 255, 0.5);
}

.reward__title {
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    color: rgb(120, 230, 255);
}

.reward__subtitle {
    font-size: 12px;
    color: rgba(176, 192, 214, 0.9);
    margin-top: 2px;
    margin-bottom: 12px;
}

.reward__slots {
    flex-direction: row;
    justify-content: space-between;
}

.reward-slot {
    width: 32%;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 10px;
    padding-left: 12px;
    background-color: rgba(18, 26, 42, 0.95);
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(150, 168, 190, 0.7);
    border-right-color: rgba(120, 230, 255, 0.2);
    border-top-color: rgba(120, 230, 255, 0.2);
    border-bottom-color: rgba(120, 230, 255, 0.2);
}

/* 등급이 한눈에 달라 보여야 한다 - 이름을 읽기 전에 알아야 하는 정보다. */
.reward-slot--rare {
    border-left-color: rgb(120, 230, 255);
}

.reward-slot--legendary {
    border-left-color: rgb(255, 196, 92);
    background-color: rgba(34, 28, 18, 0.95);
}

.reward-slot--empty {
    border-left-color: rgba(100, 112, 130, 0.5);
    background-color: rgba(14, 18, 26, 0.8);
}

.reward-slot__grade {
    font-size: 11px;
    letter-spacing: 2px;
    color: rgba(150, 168, 190, 0.9);
}

.reward-slot--rare .reward-slot__grade {
    color: rgb(120, 230, 255);
}

.reward-slot--legendary .reward-slot__grade {
    color: rgb(255, 196, 92);
}

.reward-slot__name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(230, 240, 255);
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 6px;
}

.reward-slot__effect {
    font-size: 11px;
    color: rgb(176, 192, 214);
    white-space: normal;
    min-height: 44px;
}

/* 등급이 모자라 한 단계 아래로 대체된 카드는 그렇게 말한다 (D-007). */
.reward-slot__fallback {
    font-size: 10px;
    color: rgba(214, 186, 132, 0.9);
    white-space: normal;
    margin-bottom: 4px;
}

.reward-slot__buttons {
    flex-direction: row;
    margin-top: 8px;
}

.reward-slot__take {
    flex-grow: 1;
    height: 26px;
    font-size: 12px;
    color: rgb(226, 236, 250);
    background-color: rgba(28, 44, 68, 0.95);
    border-left-color: rgba(120, 230, 255, 0.5);
    border-right-color: rgba(120, 230, 255, 0.5);
    border-top-color: rgba(120, 230, 255, 0.5);
    border-bottom-color: rgba(120, 230, 255, 0.5);
}

.reward-slot__take:hover {
    background-color: rgba(44, 70, 104, 0.95);
}

.reward-slot__reroll {
    width: 72px;
    height: 26px;
    margin-left: 6px;
    font-size: 11px;
    color: rgb(214, 226, 242);
    background-color: rgba(22, 32, 50, 0.95);
    border-left-color: rgba(120, 230, 255, 0.35);
    border-right-color: rgba(120, 230, 255, 0.35);
    border-top-color: rgba(120, 230, 255, 0.35);
    border-bottom-color: rgba(120, 230, 255, 0.35);
}

.reward-slot__reroll:hover {
    background-color: rgba(40, 60, 92, 0.95);
}

.reward__footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
}

.reward__rerolls {
    font-size: 12px;
    color: rgb(120, 230, 255);
}

.reward__refusal {
    font-size: 12px;
    color: rgb(255, 182, 172);
    white-space: normal;
    margin-top: 10px;
}

.reward__dismiss {
    height: 26px;
    min-width: 120px;
    margin-right: 0;
    font-size: 11px;
    color: rgba(200, 214, 232, 0.85);
    background-color: rgba(20, 28, 44, 0.95);
    border-left-color: rgba(120, 230, 255, 0.3);
    border-right-color: rgba(120, 230, 255, 0.3);
    border-top-color: rgba(120, 230, 255, 0.3);
    border-bottom-color: rgba(120, 230, 255, 0.3);
}

/* --- 설정 · 키 ---------------------------------------------------------------- */

.settings {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 7, 14, 0.9);
}

.settings__card {
    width: 620px;
    max-width: 94%;
    max-height: 86%;
    padding-top: 18px;
    padding-right: 20px;
    padding-bottom: 16px;
    padding-left: 20px;
    background-color: rgba(10, 16, 28, 0.97);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(120, 230, 255, 0.5);
    border-right-color: rgba(120, 230, 255, 0.5);
    border-top-color: rgba(120, 230, 255, 0.5);
    border-bottom-color: rgba(120, 230, 255, 0.5);
}

.settings__title {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgb(120, 230, 255);
    margin-bottom: 10px;
}

.settings__message {
    font-size: 12px;
    color: rgb(214, 226, 242);
    white-space: normal;
    margin-bottom: 8px;
    padding-top: 4px;
    padding-right: 8px;
    padding-bottom: 4px;
    padding-left: 8px;
    background-color: rgba(28, 44, 68, 0.9);
    border-left-width: 2px;
    border-left-color: rgba(120, 230, 255, 0.7);
}

.settings__message--failure {
    color: rgb(255, 182, 172);
    border-left-color: rgb(255, 92, 82);
}

.settings__conflicts {
    font-size: 12px;
    color: rgb(255, 182, 172);
    white-space: normal;
    margin-bottom: 8px;
}

.settings__volumes {
    margin-bottom: 4px;
}

.volume-row {
    flex-direction: row;
    align-items: center;
    padding-top: 2px;
    padding-bottom: 2px;
}

.volume-row__name {
    width: 72px;
    font-size: 12px;
    color: rgb(214, 226, 242);
}

.volume-row__slider {
    flex-grow: 1;
    margin-left: 4px;
    margin-right: 8px;
}

.volume-row__value {
    width: 44px;
    font-size: 12px;
    color: rgb(120, 230, 255);
    -unity-text-align: middle-right;
}

/* 음소거된 줄은 숫자가 남아 있어도 들리지 않는다는 걸 보여야 한다. */
.volume-row--silent .volume-row__value {
    color: rgba(150, 168, 190, 0.55);
}

.volume-row__mute {
    width: 64px;
    margin-left: 10px;
    font-size: 11px;
    color: rgb(214, 226, 242);
}

.settings__rows {
    flex-grow: 1;
    min-height: 240px;
}

.settings__footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}

.settings__button {
    height: 26px;
    min-width: 96px;
    margin-left: 8px;
    margin-right: 0;
    font-size: 12px;
    color: rgb(226, 236, 250);
    background-color: rgba(28, 44, 68, 0.95);
    border-left-color: rgba(120, 230, 255, 0.5);
    border-right-color: rgba(120, 230, 255, 0.5);
    border-top-color: rgba(120, 230, 255, 0.5);
    border-bottom-color: rgba(120, 230, 255, 0.5);
}

.settings__button:hover {
    background-color: rgba(44, 70, 104, 0.95);
}

.key-group {
    font-size: 11px;
    letter-spacing: 2px;
    color: rgba(120, 230, 255, 0.75);
    margin-top: 10px;
    margin-bottom: 2px;
}

.key-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 3px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(120, 230, 255, 0.10);
}

.key-row__name {
    font-size: 12px;
    color: rgb(214, 226, 242);
    flex-grow: 1;
}

.key-row__why {
    font-size: 11px;
    color: rgba(214, 186, 132, 0.9);
    white-space: normal;
    flex-grow: 1;
    -unity-text-align: middle-right;
    margin-right: 8px;
}

.key-row__cap {
    width: 128px;
    height: 22px;
    font-size: 12px;
    color: rgb(226, 236, 250);
    background-color: rgba(28, 44, 68, 0.95);
    border-left-color: rgba(120, 230, 255, 0.45);
    border-right-color: rgba(120, 230, 255, 0.45);
    border-top-color: rgba(120, 230, 255, 0.45);
    border-bottom-color: rgba(120, 230, 255, 0.45);
}

.key-row__cap:hover {
    background-color: rgba(44, 70, 104, 0.95);
}

/* 바뀐 키는 기본값과 달라 보여야 한다 - 재설정이 무엇을 되돌리는지 알 수 있게. */
.key-row__cap--changed {
    color: rgb(214, 186, 132);
    border-left-color: rgba(214, 186, 132, 0.8);
}

.key-row__cap--listening {
    color: rgb(10, 16, 28);
    background-color: rgb(120, 230, 255);
}

/* --- 사망 / 최종 파기 --------------------------------------------------------- */

.death {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 7, 14, 0.93);
}

.death__card {
    width: 640px;
    max-width: 92%;
    padding-top: 26px;
    padding-right: 30px;
    padding-bottom: 26px;
    padding-left: 30px;
    background-color: rgba(10, 16, 28, 0.96);
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 92, 82);
    border-right-color: rgba(120, 230, 255, 0.25);
    border-top-color: rgba(120, 230, 255, 0.25);
    border-bottom-color: rgba(120, 230, 255, 0.25);
}

.death__title {
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: rgb(255, 110, 100);
    margin-bottom: 10px;
}

.death__status {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(230, 240, 255);
    margin-bottom: 8px;
}

.death__detail {
    font-size: 13px;
    color: rgb(176, 192, 214);
    white-space: normal;
    margin-bottom: 12px;
}

.death__counts {
    flex-direction: row;
    margin-bottom: 12px;
}

.death__count {
    font-size: 14px;
    color: rgb(120, 230, 255);
    margin-right: 22px;
}

.death__unsettled {
    margin-bottom: 12px;
    padding-left: 10px;
    border-left-width: 2px;
    border-left-color: rgba(255, 196, 92, 0.6);
}

.death__unsettled-line {
    font-size: 12px;
    color: rgb(214, 186, 132);
    white-space: normal;
}

.death__next {
    font-size: 13px;
    color: rgb(200, 214, 232);
    white-space: normal;
    margin-bottom: 8px;
}

.death__id {
    font-size: 11px;
    color: rgba(150, 168, 190, 0.7);
    letter-spacing: 1px;
}

/* 저장이 아직 답하지 않았거나 실패한 상태는 결과가 아니다 - 결과처럼 보이지 않게 한다. */
.death--pending .death__card {
    border-left-color: rgba(120, 230, 255, 0.7);
}

.death--pending .death__title {
    color: rgb(170, 200, 230);
}

.death--failed .death__card {
    border-left-color: rgb(255, 196, 92);
}

.death--failed .death__title {
    color: rgb(255, 196, 92);
}

/* [확정] docs/04 section 2: 4번째 사망만 최종 파기. */
.death--destroyed .death__card {
    border-left-color: rgb(255, 60, 90);
    border-right-color: rgba(255, 60, 90, 0.35);
    border-top-color: rgba(255, 60, 90, 0.35);
    border-bottom-color: rgba(255, 60, 90, 0.35);
}

.death--destroyed .death__title {
    color: rgb(255, 70, 96);
}

/* --- 저장 상태 -------------------------------------------------------------- */

.save-notice {
    position: absolute;
    top: 18px;
    right: 24px;
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(190, 205, 225);
    background-color: rgba(10, 16, 28, 0.82);
    padding-top: 4px;
    padding-right: 10px;
    padding-bottom: 4px;
    padding-left: 10px;
    border-left-width: 2px;
    border-left-color: rgba(120, 230, 255, 0.55);
}

.save-notice--failure {
    color: rgb(255, 182, 172);
    border-left-color: rgb(255, 92, 82);
    -unity-font-style: bold;
}

/* --- 메인보드 --------------------------------------------------------------- */

.board {
    position: absolute;
    top: 18px;
    left: 24px;
    width: 300px;
    padding-top: 10px;
    padding-right: 14px;
    padding-bottom: 10px;
    padding-left: 14px;
    background-color: rgba(10, 16, 28, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(120, 230, 255, 0.45);
    border-right-color: rgba(120, 230, 255, 0.45);
    border-top-color: rgba(120, 230, 255, 0.45);
    border-bottom-color: rgba(120, 230, 255, 0.45);
}

.board__title {
    font-size: 13px;
    color: rgb(120, 230, 255);
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.board-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 2px;
}

.board-row__hardware {
    font-size: 15px;
    color: rgb(235, 245, 255);
    -unity-font-style: bold;
}

.board-row__conditions {
    font-size: 13px;
    color: rgb(170, 185, 210);
}

.board-row--done .board-row__hardware {
    color: rgb(110, 125, 155);
}

.board-row--done .board-row__conditions {
    color: rgb(110, 125, 155);
}

/* --- prompt ---------------------------------------------------------------- */

.hud__middle {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 48px;
}

.prompt {
    align-items: center;
    padding-top: 8px;
    padding-right: 20px;
    padding-bottom: 8px;
    padding-left: 20px;
    background-color: rgba(10, 16, 28, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(120, 230, 255, 0.45);
    border-right-color: rgba(120, 230, 255, 0.45);
    border-top-color: rgba(120, 230, 255, 0.45);
    border-bottom-color: rgba(120, 230, 255, 0.45);
}

.prompt__subject {
    font-size: 18px;
    color: rgb(235, 245, 255);
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.prompt__detail {
    font-size: 14px;
    color: rgb(130, 255, 215);
    margin-top: 2px;
}

.prompt--unavailable .prompt__subject {
    color: rgb(160, 170, 195);
}

.prompt--unavailable .prompt__detail {
    color: rgb(255, 170, 120);
}

.bar--prompt {
    height: 8px;
    width: 180px;
    margin-top: 6px;
}

.bar--prompt .unity-progress-bar__container {
    height: 8px;
    min-height: 8px;
}

.bar--prompt .unity-progress-bar__progress {
    background-color: rgb(130, 255, 215);
}

/* --- boss ------------------------------------------------------------------ */

.boss {
    width: 46%;
    align-items: center;
}

.boss__name {
    font-size: 15px;
    color: rgb(255, 120, 160);
    letter-spacing: 2px;
    margin-bottom: 4px;
    -unity-font-style: bold;
}

/* --- vitals ---------------------------------------------------------------- */

.vitals {
    width: 280px;
}

.vitals__shield {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.vitals__shield-label {
    font-size: 13px;
    color: rgb(120, 230, 255);
    letter-spacing: 1px;
    margin-right: 6px;
}

.vitals__shield-value {
    font-size: 14px;
    color: rgb(190, 245, 255);
    -unity-font-style: bold;
}

/* --- skills ---------------------------------------------------------------- */

.skills {
    flex-direction: row;
    align-items: flex-end;
}

.skill {
    width: 62px;
    margin-left: 10px;
    align-items: center;
}

.skill__key {
    font-size: 12px;
    color: rgb(150, 160, 190);
    letter-spacing: 1px;
    margin-bottom: 3px;
}

.skill--ready .skill__key {
    color: rgb(130, 255, 215);
}

.skill--empty {
    opacity: 0.35;
}

/* --- area ------------------------------------------------------------------ */

.area {
    width: 260px;
    align-items: flex-end;
}

.area__name {
    font-size: 15px;
    color: rgb(120, 230, 255);
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.area__objectives {
    font-size: 20px;
    color: rgb(235, 245, 255);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.area__gauge {
    width: 100%;
    margin-top: 4px;
}

.area__gauge-label {
    font-size: 13px;
    color: rgb(150, 160, 190);
    letter-spacing: 1px;
}

.area__gauge--armed .area__gauge-label {
    color: rgb(130, 255, 215);
}

/* --- bars ------------------------------------------------------------------ */
/*
 * ProgressBar is several elements under one root, so the neon look has to reach its
 * children as well as the element written in the UXML.
 */

.bar {
    height: 18px;
    margin-top: 0;
    margin-bottom: 0;
}

.bar .unity-progress-bar__container {
    height: 18px;
    min-height: 18px;
}

.bar .unity-progress-bar__background {
    background-color: rgba(10, 16, 28, 0.85);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(120, 230, 255, 0.4);
    border-right-color: rgba(120, 230, 255, 0.4);
    border-top-color: rgba(120, 230, 255, 0.4);
    border-bottom-color: rgba(120, 230, 255, 0.4);
}

.bar .unity-progress-bar__progress {
    background-color: rgb(120, 230, 255);
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
}

.bar .unity-progress-bar__title {
    font-size: 13px;
    color: rgb(235, 245, 255);
    -unity-font-style: bold;
}

.bar--health .unity-progress-bar__progress {
    background-color: rgb(255, 92, 134);
}

.bar--mana .unity-progress-bar__progress {
    background-color: rgb(126, 150, 255);
}

.bar--boss {
    height: 22px;
    width: 100%;
}

.bar--boss .unity-progress-bar__container {
    height: 22px;
    min-height: 22px;
}

.bar--boss .unity-progress-bar__progress {
    background-color: rgb(255, 92, 134);
}

.bar--skill {
    height: 8px;
    width: 100%;
}

.bar--skill .unity-progress-bar__container {
    height: 8px;
    min-height: 8px;
}

.bar--skill .unity-progress-bar__progress {
    background-color: rgb(90, 110, 150);
}

.skill--ready .bar--skill .unity-progress-bar__progress {
    background-color: rgb(130, 255, 215);
}

.bar--gauge {
    height: 10px;
}

.bar--gauge .unity-progress-bar__container {
    height: 10px;
    min-height: 10px;
}

.bar--gauge .unity-progress-bar__progress {
    background-color: rgb(190, 140, 255);
}
